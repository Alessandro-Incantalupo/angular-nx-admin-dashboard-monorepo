{
  "name": "admin-dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/admin-dashboard/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": [
        {
          "projects": "design-system",
          "target": "build-styles"
        }
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/admin-dashboard",
        "index": "apps/admin-dashboard/src/index.html",
        "browser": "apps/admin-dashboard/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/admin-dashboard/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/admin-dashboard/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "apps/admin-dashboard/src/mocks",
            "output": "mocks"
          },
          {
            "glob": "favicon.ico",
            "input": "apps/admin-dashboard/public",
            "output": "/"
          }
        ],
        "styles": [
          "apps/admin-dashboard/src/styles.css",
          "dist/libs/design-system/styles.css"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/admin-dashboard/src/environments/environment.ts",
              "with": "apps/admin-dashboard/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/admin-dashboard/src/environments/environment.ts",
              "with": "apps/admin-dashboard/src/environments/environment.development.ts"
            }
          ],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "statsJson": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "production",
      "readyWhen": {
        "signal": true
      },
      "options": {
        "port": 4300
      },
      "configurations": {
        "production": {
          "buildTarget": "admin-dashboard:build:production"
        },
        "development": {
          "buildTarget": "admin-dashboard:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "admin-dashboard:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "dependsOn": [
        {
          "projects": "design-system",
          "target": "build-styles"
        }
      ],
      "options": {
        "tsConfig": "apps/admin-dashboard/tsconfig.spec.json",
        "setupFiles": ["apps/admin-dashboard/src/test-setup.ts"],
        "watch": false
      },
      "configurations": {
        "ci": {
          "coverage": true,
          "coverageReporters": ["text-summary", "lcov"]
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "admin-dashboard:build",
        "port": 4200,
        "staticFilePath": "dist/apps/admin-dashboard/browser",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    },
    "analyze": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx build admin-dashboard --stats-json --named-chunks && npx -y @angular-experts/hawkeye dist/apps/admin-dashboard/stats.json"
      }
    },
    "build-clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist && nx run-many -t build --skip-nx-cache"
      }
    }
  }
}
