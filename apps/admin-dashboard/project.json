{
  "name": "admin-dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/admin-dashboard/src",
  "tags": ["scope:client"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/admin-dashboard",
        "index": "apps/admin-dashboard/src/index.html",
        "browser": "apps/admin-dashboard/src/main.ts",
        "tsConfig": "apps/admin-dashboard/tsconfig.app.json",
        "assets": [{ "glob": "**/*", "input": "apps/admin-dashboard/public" }],
        "styles": ["apps/admin-dashboard/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "400kb",
              "maximumError": "550kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "fonts": false,
            "styles": { "minify": true, "inlineCritical": false }
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4300,
        "proxyConfig": "apps/admin-dashboard/proxy.conf.json"
      },
      "configurations": {
        "production": { "buildTarget": "admin-dashboard:build:production" },
        "development": { "buildTarget": "admin-dashboard:build:development" }
      }
    },
    "typecheck": {
      "command": "ngc -p apps/admin-dashboard/tsconfig.app.json --noEmit"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/admin-dashboard/tsconfig.spec.json",
        "buildTarget": "admin-dashboard:build:development",
        "runner": "vitest",
        "watch": false
      }
    }
  }
}
