# Copy to apps/api/.env for local development. Never commit the real file.

# The API connects as the app's own role (rows only). Created by `pnpm db:app-role`.
DATABASE_URL=postgres://app_runtime:change-me-app-password@localhost:5432/dashboard

# The owner: migrations, the app role script and the seed use it.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dashboard

# Password `pnpm db:app-role` gives app_runtime (16+ characters, same as in DATABASE_URL).
APP_DATABASE_PASSWORD=change-me-app-password

# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Where the Angular app runs. The dev server proxies /api to this API.
FRONTEND_ORIGIN=http://localhost:4300

# Proxies in front of the API that append to X-Forwarded-For (0 locally).
TRUSTED_PROXY_HOPS=0

PORT=3100
DATABASE_POOL_MAX=5

# Password for admin@example.com, set by `pnpm db:seed` when the account is created.
SEED_ADMIN_PASSWORD=
