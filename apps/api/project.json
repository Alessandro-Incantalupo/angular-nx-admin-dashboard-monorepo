{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:server"],
  "targets": {
    "serve": {
      "continuous": true,
      "command": "tsx watch --tsconfig apps/api/tsconfig.json --env-file-if-exists=apps/api/.env apps/api/src/main.ts"
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/api",
        "main": "apps/api/src/main.ts",
        "tsConfig": "apps/api/tsconfig.json",
        "platform": "node",
        "target": "node24",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": true,
        "generatePackageJson": false,
        "esbuildOptions": {
          "outExtension": {
            ".js": ".mjs"
          },
          "banner": {
            "js": "import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);"
          }
        },
        "skipTypeCheck": true
      }
    },
    "typecheck": {
      "command": "tsc -p apps/api/tsconfig.json"
    },
    "db-generate": {
      "command": "drizzle-kit generate",
      "options": {
        "cwd": "apps/api"
      }
    },
    "db-migrate": {
      "command": "tsx --tsconfig apps/api/tsconfig.json --env-file-if-exists=apps/api/.env apps/api/scripts/migrate.ts"
    },
    "db-seed": {
      "command": "tsx --tsconfig apps/api/tsconfig.json --env-file-if-exists=apps/api/.env apps/api/scripts/seed.ts"
    },
    "db-app-role": {
      "command": "tsx --tsconfig apps/api/tsconfig.json --env-file-if-exists=apps/api/.env apps/api/scripts/app-role.ts"
    }
  }
}
