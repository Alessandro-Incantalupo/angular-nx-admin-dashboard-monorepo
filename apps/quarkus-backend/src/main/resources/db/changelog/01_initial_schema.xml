<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <!-- 
      CHIPSET: 01_initial_schema
      AUTHOR: admin
      GOAL: Define the initial 'ad_user' table structure.
    -->
    <changeSet id="01-initial-user-table" author="admin">
        <createTable tableName="ad_user">
            <!-- 1. The ID: A standard UUID -->
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            
            <!-- 2. User Basic Info -->
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            
            <!-- 3. Status & Role (Stored as lowercase strings) -->
            <column name="role" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            
            <!-- 4. The Sorting Key (Newest First) -->
            <column name="created_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
