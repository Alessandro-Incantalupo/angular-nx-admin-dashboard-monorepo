{
  "realm": "quarkus",
  "enabled": true,
  "clients": [
    {
      "clientId": "quarkus-app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:4300/*",
        "http://localhost:4200/*",
        "*"
      ],
      "webOrigins": ["*"],
