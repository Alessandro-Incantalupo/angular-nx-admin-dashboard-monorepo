{
  "name": "admin-dashboard",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve -p api admin-dashboard",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint && prettier --check .",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "format": "prettier --write .",
    "db:generate": "nx run api:db-generate",
    "db:migrate": "nx run api:db-migrate",
    "db:seed": "nx run api:db-seed",
    "db:app-role": "nx run api:db-app-role",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,html,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~22.3.0",
    "@angular/common": "~22.3.0",
    "@angular/compiler": "~22.3.0",
    "@angular/core": "~22.3.0",
    "@angular/forms": "~22.3.0",
    "@angular/platform-browser": "~22.3.0",
    "@angular/router": "~22.3.0",
    "@hono/node-server": "^2.1.11",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/signals": "^22.0.1",
    "@primeuix/themes": "^3.1.1",
    "better-auth": "^1.7.20",
    "chart.js": "^4.6.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.0",
    "postgres": "^3.4.7",
    "primeng": "^22.1.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.3.0",
    "@angular-devkit/schematics": "~22.3.0",
    "@angular/build": "~22.3.0",
    "@angular/cli": "~22.3.0",
    "@angular/compiler-cli": "~22.3.0",
    "@angular/language-service": "~22.3.0",
    "@electric-sql/pglite": "^0.5.0",
    "@eslint/js": "^9.39.1",
    "@nx/angular": "24.0.6",
    "@nx/devkit": "24.0.6",
    "@nx/esbuild": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@schematics/angular": "~22.3.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.10.1",
    "angular-eslint": "22.8.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "jsonc-eslint-parser": "^2.4.1",
    "lint-staged": "^16.2.7",
    "nx": "24.0.6",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@12.21.0",
  "description": "Angular admin dashboard with a Hono API, Postgres and Better Auth in an Nx monorepo.",
  "type": "module"
}
